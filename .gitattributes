# Normalise line endings to LF in the repository for text sources, so that
# diffs and patches are stable across Windows and Unix checkouts, while pinned
# binaries and compressed archives are never touched by conversion.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.tex   text eol=lf
*.bib   text eol=lf
*.cff   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ps1   text eol=crlf

# Binary / compressed formats: never convert, never diff.
*.npz   binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.tif   binary
*.tiff  binary
*.zip   binary
*.gz    binary

# Generated artefacts: exclude from language statistics and from diffs.
figs/**/*.svg  linguist-generated=true
figs/**/*.tiff linguist-generated=true
manuscript/overleaf/** linguist-generated=true

# Frozen numerical evidence uses byte-exact hashes; retain archived line endings.
docs/innovation_20261031/source_snapshot/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/innovation_20261031/results_refined/summary.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
manuscript/README.TXT -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
